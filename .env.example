# ── Crucible API ──────────────────────────────────────────────────────────────
# Admin key. Used only to mint each signed-in user's personal API key; all calls
# made on the user's behalf use that personal key instead.
CRUCIBLE_API_KEY=
CRUCIBLE_API_URL=https://crucible.lbl.gov/api/v2

# ── OIDC / ORCID authentication ───────────────────────────────────────────────
ORCID_CLIENT_ID=                          # ORCID OAuth app client ID
ORCID_CLIENT_SECRET=                      # ORCID OAuth app client secret
PYOIDC_SECRET=                            # Random secret for Flask session signing
OIDC_REDIRECT_URI="http://127.0.0.1:8000/redirect_uri"

# ── Label printer (MQTT) ──────────────────────────────────────────────────────
MQTT_BROKER=mqtt.mfdata.org
MQTT_PORT=8883
MQTT_USERNAME=crucible-printers
MQTT_PASSWORD=

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8000
URL_PREFIX=                               # Sub-path the app is mounted under. Empty for local dev at /
